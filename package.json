{
  "name": "smart-attendance-android",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Attendance Android app (Capacitor wrapper around the existing web frontend + Flask backend)",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
